# Copy to .env.local and fill in.

# Optional. A GitHub token with read:user / public repo scope enables the live
# contributions graph. Without it the site renders the static fallback graph.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# The GitHub username whose contributions to display.
# Also configurable in src/content/site.config.ts (github.username).
NEXT_PUBLIC_SITE_URL=https://example.com
