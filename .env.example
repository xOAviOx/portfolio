# Copy to .env.local and fill in.

# Optional. A GitHub token with read:user / public repo scope enables the live
# contributions graph. Without it the site renders the static fallback graph.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Absolute origin for canonical URLs, OG images, sitemap, and robots.
# Leave UNSET on Vercel — it auto-fills from your *.vercel.app production
# domain (VERCEL_PROJECT_PRODUCTION_URL). Only set this when you attach a
# custom domain, e.g. https://avishukla.dev
NEXT_PUBLIC_SITE_URL=
